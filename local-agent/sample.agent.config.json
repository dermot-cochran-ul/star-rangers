{
  "_comment": "Copy to agent.config.json (untracked) and fill in. Two worked examples below — keep exactly one 'provider'.",

  "_example_azure_openai": {
    "api_style": "openai-chat",
    "endpoint": "https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT/chat/completions?api-version=2024-10-21",
    "model": "",
    "max_tokens": 8192,
    "auth": { "mode": "azure-cli", "scope": "https://cognitiveservices.azure.com/.default" }
  },

  "_example_claude_on_azure_ai_foundry": {
    "api_style": "anthropic-messages",
    "endpoint": "https://YOUR-RESOURCE.services.ai.azure.com/anthropic/v1/messages",
    "model": "claude-sonnet-4-5",
    "max_tokens": 8192,
    "auth": { "mode": "api-key-env", "env": "AZURE_FOUNDRY_API_KEY", "header": "x-api-key" },
    "extra_headers": { "anthropic-version": "2023-06-01" }
  },

  "provider": {
    "api_style": "openai-chat",
    "endpoint": "",
    "model": "",
    "max_tokens": 8192,
    "auth": { "mode": "azure-cli", "scope": "https://cognitiveservices.azure.com/.default" }
  },

  "command_timeout_seconds": 120
}
